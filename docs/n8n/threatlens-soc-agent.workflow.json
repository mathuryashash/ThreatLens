    {
      "id": "5e0c0e71-330a-4544-81ca-e84d67a3eeb1",
      "name": "lookup_ip_reputation",
      "type": "@n8n/n8n-nodes-langchain.toolCode",
      "typeVersion": 1.1,
      "position": [
        1120,
        160
      ],
      "parameters": {
        "name": "lookup_ip_reputation",
        "description": "Demo IP reputation lookup. Input: a single IP address string. For live AbuseIPDB, replace this with the AbuseIPDB HTTP Request Tool described in README.",
        "jsCode": "const ip = String(query || '').trim();\nconst scores = { '203.0.113.42': 87, '198.51.100.12': 72, '45.33.32.156': 61, '192.0.2.77': 58, '203.0.113.99': 80 };\nreturn JSON.stringify({ ip, provider: 'demo-reputation', abuseConfidenceScore: scores[ip] ?? 25, note: 'Demo fallback. Wire AbuseIPDB HTTP Request Tool for live reputation.' });"
      }
    },
    {
      "id": "d61fb096-14b2-4a1f-8928-335a620db985",
      "name": "get_threat_history",
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.2,
      "position": [
        1320,
        160
      ],
      "parameters": {
        "url": "={{ $('Config').first().json.base_url }}/api/threats",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "session_id",
              "value": "={{ $('Load Demo Logs').first().json.session_id }}"
            },
            {
              "name": "limit",
              "value": "200"
            }
          ]
        },
        "options": {},
        "toolDescription": "Fetch recent ThreatLens threats for this session. Use this to check repeated IPs or repeated attack types."
      }
    },
    {
      "id": "038bf212-2528-42ca-8f73-a7a983ae0d50",
      "name": "calculate_risk_score",
      "type": "@n8n/n8n-nodes-langchain.toolCode",
      "typeVersion": 1.1,
      "position": [
        1520,
        160
      ],
      "parameters": {
        "name": "calculate_risk_score",
        "description": "Calculate combined risk. Input must be JSON with severity_score, confidence, abuse_score, repeated_count, and criticality_hint fields when available.",
        "jsCode": "let x = {};\ntry { x = JSON.parse(query); } catch (e) { x = { raw: query }; }\nconst sev = Number(x.severity_score ?? x.severity ?? 50);\nconst conf = Number(x.confidence ?? 0.75) * 10;\nconst abuse = Number(x.abuse_score ?? x.abuseConfidenceScore ?? 0) * 0.25;\nconst repeat = Math.min(Number(x.repeated_count ?? 0) * 3, 15);\nconst hint = /critical|rce|ssrf|credential|brute|priv/i.test(String(x.criticality_hint ?? x.type ?? '')) ? 10 : 0;\nconst risk = Math.max(0, Math.min(100, Math.round(sev * 0.65 + conf + abuse + repeat + hint)));\nreturn JSON.stringify({ risk, inputs: x });"
      }
    },
    {
      "id": "2ce88125-7698-4e1e-8351-bf0f3112a37e",
      "name": "Parse Agent Decision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1240,
        -120
      ],
      "parameters": {
        "jsCode": "const raw = $input.first().json.output ?? $input.first().json.text ?? JSON.stringify($input.first().json);\nlet parsed;\ntry { parsed = JSON.parse(String(raw).replace(/^```json\\s*/, '').replace(/```$/, '')); }\ncatch (e) { throw new Error(`Agent did not return valid JSON: ${raw}`); }\nparsed.max_risk = Number(parsed.max_risk || 0);\nparsed.critical = Boolean(parsed.critical || parsed.max_risk >= 80);\nreturn [{ json: parsed }];"
      }
    },
