    {
      "id": "7b9560a2-9747-49e7-9f4b-5bc523fac220",
      "name": "Build Agent Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        -120
      ],
      "parameters": {
        "jsCode": "const body = $input.first().json;\nconst threats = (body.threats || []).map(t => ({\n  id: t.id, type: t.threat_type, severity: t.severity, severity_score: t.severity_score,\n  confidence: t.confidence, source_ip: t.source_ip, summary: t.summary,\n  evidence: (t.evidence || []).slice(0, 2), detected_at: t.detected_at\n}));\nreturn [{ json: {\n  session_id: $('Load Demo Logs').first().json.session_id,\n  threats,\n  by_severity: body.by_severity,\n  agent_prompt: `Analyze this ThreatLens feed. Use lookup_ip_reputation for source IPs, get_threat_history when useful, and calculate_risk_score before deciding alerting. Return ONLY valid JSON matching: {\"max_risk\": number, \"critical\": boolean, \"primary_threat_id\": string|null, \"primary_ip\": string|null, \"title\": string, \"summary\": string, \"recommended_actions\": string[], \"slack_message\": string, \"email_subject\": string, \"email_body\": string}. Threats: ${JSON.stringify(threats)}`\n}}];"
      }
    },
    {
      "id": "66ab5b16-deb4-4953-9448-cb7c56583b4c",
      "name": "AI Security Analyst Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.8,
      "position": [
        1020,
        -120
